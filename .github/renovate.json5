{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  additionalBranchPrefix: '{{manager}}/',
  commitBodyTable: true,
  commitMessageAction: 'Bump',
  dependencyDashboard: {
    enabled: false,
  },
  extends: [
    'config:best-practices',
    'customManagers:githubActionsVersions',
    'helpers:pinGitHubActionDigestsToSemver',
    ':enableVulnerabilityAlerts',
  ],
  labels: [
    'dependencies',
  ],
  osvVulnerabilityAlerts: true,
  prConcurrentLimit: 20,
  dockerfile: {
    includePaths: [
      'docker/**',
      'test/IntegrationTests/docker/**',
    ],
    // Clear the inherited test-directory exclusion for these paths.
    ignorePaths: [],
  },
  packageRules: [
    {
      description: 'Restrict generated modern .NET dependencies to vulnerability fixes',
      matchManagers: [
        'nuget',
      ],
      matchFileNames: [
        'src/OpenTelemetry.AutoInstrumentation.Assemblies/NetCoreTransientDependencies.props',
      ],
      // Match OSV's affected version exactly and exclude GitHub's open-ended
      // alert ranges. OSV restores NuGet versioning when selecting a fix.
      versioning: 'loose',
      enabled: false,
    },
    {
      matchFileNames: [
        'docker/debian.dockerfile',
      ],
      matchDatasources: [
        'deb',
      ],
      registryUrls: [
        'https://deb.debian.org/debian?suite=bookworm&components=main&binaryArch=amd64',
        'https://deb.debian.org/debian?suite=bookworm-updates&components=main&binaryArch=amd64',
        'https://deb.debian.org/debian-security?suite=bookworm-security&components=main&binaryArch=amd64',
      ],
    },
    {
      matchFileNames: [
        'docker/debian-arm64.dockerfile',
      ],
      matchDatasources: [
        'deb',
      ],
      registryUrls: [
        'https://deb.debian.org/debian?suite=bookworm&components=main&binaryArch=arm64',
        'https://deb.debian.org/debian?suite=bookworm-updates&components=main&binaryArch=arm64',
        'https://deb.debian.org/debian-security?suite=bookworm-security&components=main&binaryArch=arm64',
      ],
    },
    {
      matchFileNames: [
        'docker/ubuntu1804.dockerfile',
      ],
      matchDatasources: [
        'deb',
      ],
      registryUrls: [
        'https://archive.ubuntu.com/ubuntu?suite=bionic&components=main&binaryArch=amd64',
        'https://archive.ubuntu.com/ubuntu?suite=bionic-updates&components=main&binaryArch=amd64',
        'https://security.ubuntu.com/ubuntu?suite=bionic-security&components=main&binaryArch=amd64',
      ],
    },
    {
      matchFileNames: [
        'docker/ubuntu1804.dockerfile',
      ],
      matchDatasources: [
        'deb',
      ],
      matchPackageNames: [
        'clang-12',
      ],
      registryUrls: [
        'https://apt.llvm.org/bionic?suite=llvm-toolchain-bionic-12&components=main&binaryArch=amd64',
      ],
    },
    {
      matchFileNames: [
        'docker/ubuntu1804.dockerfile',
      ],
      matchDatasources: [
        'deb',
      ],
      matchPackageNames: [
        'g++-9',
      ],
      registryUrls: [
        'https://ppa.launchpadcontent.net/ubuntu-toolchain-r/test/ubuntu?suite=bionic&components=main&binaryArch=amd64',
      ],
    },
    {
      description: 'Keep the Npgsql EF Core provider for net10.0 on 10.x',
      matchManagers: [
        'nuget',
      ],
      matchFileNames: [
        'test/test-applications/integrations/TestApplication.EntityFrameworkCore.Npgsql/TestApplication.EntityFrameworkCore.Npgsql.csproj',
      ],
      matchPackageNames: [
        'Npgsql.EntityFrameworkCore.PostgreSQL',
      ],
      matchCurrentValue: '/^10\\./',
      allowedVersions: '/^10\\./',
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      description: [
        'Update GitHub runner labels in workflow fields and matrix values',
      ],
      managerFilePatterns: [
        '/(^|/)(workflow-templates|\\.(?:github|gitea|forgejo)/(?:workflows|actions))/.+\\.ya?ml$/',
        '/(^|/)action\\.ya?ml$/',
      ],
      matchStrings: [
        '# renovate:\\s*datasource=(?<datasource>github-runners)(?:\\s+[A-Za-z][A-Za-z0-9_-]*=[^\\s]+)*?(?:\\s+versioning=(?<versioning>[^\\s]+))?(?:\\s+[A-Za-z][A-Za-z0-9_-]*=[^\\s]+)*\\s*\\r?\\n\\s*(?:-\\s*)?(?:[A-Za-z0-9_-]+:\\s*)?[\'"]?(?<depName>[a-zA-Z]+)-(?<currentValue>[A-Za-z0-9._-]+)[\'"]?',
      ],
    },
    {
      customType: 'regex',
      description: [
        'Update Alpine package version ARGs in Dockerfiles',
      ],
      managerFilePatterns: [
        '/^docker/alpine\\.dockerfile$/',
      ],
      matchStrings: [
        '# renovate:\\s*datasource=(?<datasource>repology)\\s+depName=(?<depName>[^\\s]+)\\s*\\r?\\n\\s*ARG\\s+[A-Z0-9_]+_VERSION=(?<currentValue>[^\\s]+)',
      ],
      packageNameTemplate: 'alpine_3_23/{{{depName}}}',
      versioningTemplate: 'apk',
    },
    {
      customType: 'regex',
      description: [
        'Update Debian and Ubuntu package version ARGs in Dockerfiles',
      ],
      managerFilePatterns: [
        '/^docker/(?:debian(?:-arm64)?|ubuntu1804)\\.dockerfile$/',
      ],
      matchStrings: [
        '# renovate:\\s*datasource=(?<datasource>deb)\\s+depName=(?<depName>[^\\s]+)\\s*\\r?\\n\\s*ARG\\s+[A-Z0-9_]+_VERSION=(?<currentValue>[^\\s]+)',
      ],
      versioningTemplate: 'deb',
    },
    {
      customType: 'regex',
      description: [
        'Update CentOS Stream package version ARGs in Dockerfiles',
      ],
      managerFilePatterns: [
        '/^docker/centos-stream9\\.dockerfile$/',
      ],
      matchStrings: [
        '# renovate:\\s*datasource=(?<datasource>rpm)\\s+depName=(?<depName>[^\\s]+)\\s*\\r?\\n\\s*ARG\\s+[A-Z0-9_]+_VERSION=(?<currentValue>[^\\s]+)',
      ],
      registryUrlTemplate: 'https://mirror.stream.centos.org/9-stream/AppStream/x86_64/os/repodata/',
      versioningTemplate: 'rpm',
    },
    {
      customType: 'regex',
      description: [
        'Update Ubuntu 18.04 CMake binary version ARG in Dockerfiles',
      ],
      managerFilePatterns: [
        '/^docker/ubuntu1804\\.dockerfile$/',
      ],
      matchStrings: [
        '# renovate:\\s*datasource=(?<datasource>github-releases)\\s+depName=(?<depName>Kitware/CMake)\\s*\\r?\\n\\s*ARG\\s+CMAKE_VERSION=(?<currentValue>[^\\s]+)',
      ],
      extractVersionTemplate: '^(?<version>\\d+\\.\\d+\\.\\d+)$',
      versioningTemplate: 'semver',
    },
  ],
}
