<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <!-- Override the vulnerable System.Security.Cryptography.Pkcs dependency from Microsoft.Data.SqlClient.
         The advisory was fixed in 10.0.13; use the current .NET 10 servicing version.
         https://github.com/advisories/GHSA-846f-f764-76mx -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
  </ItemGroup>
</Project>
