<Project>
  <ItemGroup Label="Versions from CommonExcludedAssets.props: Transient dependencies of OpenTelemetry.Instrumentation.Wcf">
    <PackageVersion Include="Microsoft.Win32.SystemEvents" Version="4.7.0" />
    <PackageVersion Include="System.Drawing.Common" Version="4.7.2" />
    <PackageVersion Include="System.Windows.Extensions" Version="4.7.0" />
  </ItemGroup>
  <ItemGroup Label="Versions from CommonExcludedAssets.props: Transient dependencies of OpenTelemetry.Instrumentation.StackExchangeRedis">
    <PackageVersion Include="Pipelines.Sockets.Unofficial" Version="2.2.8" />
    <PackageVersion Include="StackExchange.Redis" Version="2.6.122" />
    <PackageVersion Include="System.Threading.Channels" Version="5.0.0" />
  </ItemGroup>
  <!-- TODO: should be discussed or a ticket should be filed: bring additional assemblies previously not in the output -->
  <ItemGroup Label="Versions from CommonExcludedAssets.props: Packages requiring filtering re-evaluation">
    <PackageVersion Include="Microsoft.NETCore.Platforms" Version="3.1.4" Condition=" '$(TargetFrameworkIdentifier)' == '.NETCoreApp' " Label="Legacy transitive dependencies likely not bringing any libraries to output: likely should be excluded" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="4.7.0" Condition=" '$(TargetFrameworkIdentifier)' == '.NETCoreApp' " Label="Transient dependencies of OpenTelemetry.Instrumentation.Wcf: likely should be excluded" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="4.7.1" Condition=" '$(TargetFrameworkIdentifier)' == '.NETCoreApp' and '$(MSBuildProjectName)' != 'OpenTelemetry.AutoInstrumentation.AspNetCoreBootstrapper' " Label="Transient dependencies of OpenTelemetry.Instrumentation.Wcf: likely should be excluded" />
  </ItemGroup>
</Project>
