<Project>
  <PropertyGroup>
    <!-- Use the same NuGet.Versioning version for restore and the DLL packed with the task. -->
    <NuGetVersioningVersion>6.5.0</NuGetVersioningVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="15.9.20" />
    <PackageVersion Include="NuGet.Versioning" Version="$(NuGetVersioningVersion)" />
  </ItemGroup>
</Project>
