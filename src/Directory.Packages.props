<Project>
  <Import Project="..\Directory.Packages.props" />
  <ItemGroup Label="Versions from Directory.Build.props in the same folder">
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
  </ItemGroup>
  <ItemGroup Label="Versions from OpenTelemetry.AutoInstrumentation.BuildTasks.csproj">
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="15.9.20" />
    <PackageVersion Include="NuGet.Versioning" Version="$(NuGetVersioningVersion)" />
  </ItemGroup>
  <ItemGroup Label="Versions from OpenTelemetry.AutoInstrumentation.csproj and OTEL transitive dependencies">
    <PackageVersion Include="OpenTelemetry.Api.ProviderBuilderExtensions" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.HttpListener" Version="1.21.0-beta.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.Zipkin" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Propagators" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNet" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNet.TelemetryHttpModule" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.21.0-beta.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.GrpcNetClient" Version="1.21.0-beta.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Process" Version="1.21.0-rc.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Quartz" Version="1.21.0-beta.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.StackExchangeRedis" Version="1.21.0-beta.1" />
    <PackageVersion Include="OpenTelemetry.Shims.OpenTracing" Version="1.21.0-beta.1" />
    <PackageVersion Include="OpenTelemetry.Resources.Azure" Version="1.21.0-beta.1" />
    <PackageVersion Include="OpenTelemetry.Resources.Container" Version="1.21.0-beta.1" />
    <PackageVersion Include="OpenTelemetry.Resources.Host" Version="1.21.0-beta.1" />
    <PackageVersion Include="OpenTelemetry.Resources.OperatingSystem" Version="1.21.0-beta.1" />
    <PackageVersion Include="OpenTelemetry.Resources.Process" Version="1.21.0-rc.1" />
    <PackageVersion Include="OpenTelemetry.Resources.ProcessRuntime" Version="1.21.0-beta.1" />
    <PackageVersion Include="OpenTracing" Version="0.12.1" />
  </ItemGroup>
  <ItemGroup Label="Versions from SourceGenerators.csproj">
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
  </ItemGroup>
  <Import Project="CommonExcludedAssets.Packages.props" />
</Project>
