<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" VersionOverride="$(LibraryVersion)" Condition=" '$(LibraryVersion)' != '' or '$(TargetFramework)' != 'net10.0' " />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" VersionOverride="11.0.0" Condition=" '$(LibraryVersion)' == '' and '$(TargetFramework)' == 'net10.0' " />
  </ItemGroup>

</Project>
