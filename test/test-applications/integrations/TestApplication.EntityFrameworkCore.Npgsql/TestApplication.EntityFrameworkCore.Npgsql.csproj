<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" VersionOverride="$(LibraryVersion)" Condition=" '$(LibraryVersion)' != '' or '$(TargetFramework)' != 'net10.0' " />
    <!-- .NET 10 requires the 10.x provider. Renovate enforces the cap in .github/renovate.json5. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" VersionOverride="10.0.4" Condition=" '$(LibraryVersion)' == '' and '$(TargetFramework)' == 'net10.0' " />
  </ItemGroup>

</Project>
