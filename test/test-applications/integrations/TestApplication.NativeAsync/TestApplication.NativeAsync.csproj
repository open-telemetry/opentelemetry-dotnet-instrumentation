<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
    <!-- The profiler references used to compile the test integration must be resolved from tracer-home at runtime. -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <Features>$(Features);runtime-async=on</Features>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <!-- Runtime-async lowering uses the preview AsyncHelpers.Await API that this test intentionally exercises. -->
    <NoWarn>$(NoWarn);CA2252</NoWarn>
    <!-- AsyncHelpers is evaluation-only; SYSLIB5007 requires explicit suppression to compile runtime-async methods. -->
    <NoWarn>$(NoWarn);SYSLIB5007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Update="config.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <ProjectReference Include="..\dependency-libs\TestLibrary.NativeAsync\TestLibrary.NativeAsync.csproj" />
  </ItemGroup>
</Project>
