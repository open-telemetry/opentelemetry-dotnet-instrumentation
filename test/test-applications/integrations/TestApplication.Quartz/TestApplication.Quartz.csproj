<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">$(TargetFrameworks);net472</TargetFrameworks>
    <DefineConstants Condition="'$(TargetFramework)' != 'net472' and ('$(LibraryVersion)' =='' or $([MSBuild]::VersionGreaterThanOrEquals('$(LibraryVersion)', '4.0.0')))">$(DefineConstants);QUARTZ_4_0_0_OR_GREATER</DefineConstants>
    <DefineConstants Condition="'$(LibraryVersion)'=='' or $([MSBuild]::VersionGreaterThanOrEquals('$(LibraryVersion)', '3.7.0'))">$(DefineConstants);QUARTZ_3_7_0_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Quartz" VersionOverride="$(LibraryVersion)" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net472' or ('$(LibraryVersion)' != '' and $([MSBuild]::VersionLessThan('$(LibraryVersion)', '4.0.0'))) ">
    <PackageReference Include="Quartz.Extensions.DependencyInjection" VersionOverride="$(LibraryVersion)" />
    <PackageReference Include="Quartz.Extensions.Hosting" VersionOverride="$(LibraryVersion)" />
  </ItemGroup>
  <ItemGroup Condition=" '$(LibraryVersion)' == '' and '$(TargetFramework)' == 'net472' ">
    <PackageReference Update="Quartz" VersionOverride="3.22.7" />
    <PackageReference Update="Quartz.Extensions.DependencyInjection" VersionOverride="3.22.7" />
    <PackageReference Update="Quartz.Extensions.Hosting" VersionOverride="3.22.7" />
  </ItemGroup>

</Project>
