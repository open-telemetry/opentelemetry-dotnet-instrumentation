<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">$(TargetFrameworks);net472</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(TargetFramework)' != 'net472' and ( '$(LibraryVersion)' == '' or ( '$(LibraryVersion)' != '' and '$(LibraryVersion)' &gt;= '10.2.0' ) ) ">
    <DefineConstants>$(DefineConstants);NSERVICEBUS_HOSTED_ENDPOINT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Condition=" '$(UseNServiceBusHostedEndpoint)' == 'true' " />
    <PackageReference Include="NServiceBus" VersionOverride="$(LibraryVersion)" Condition=" '$(LibraryVersion)' != '' or '$(TargetFramework)' != 'net472' " />
    <!-- NServiceBus 8.x is the last major compatible with .NET Framework. Renovate enforces the cap in .github/renovate.json5. -->
    <PackageReference Include="NServiceBus" VersionOverride="8.2.7" Condition=" '$(LibraryVersion)' == '' and '$(TargetFramework)' == 'net472' " />
  </ItemGroup>

</Project>
