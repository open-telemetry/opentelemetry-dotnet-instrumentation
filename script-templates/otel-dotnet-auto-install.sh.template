#!/bin/sh
set -e

RELEASE_REPOSITORY="open-telemetry/opentelemetry-dotnet-instrumentation"
RELEASE_WORKFLOW="$RELEASE_REPOSITORY/.github/workflows/release.yml"

assert_release_version() {
  if ! printf '%s\n' "$1" | grep -Eq '^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?$'; then
    echo "Invalid release version '$1'." >&2
    return 1
  fi
}

get_github_cli_path() {
  if ! command -v gh > /dev/null 2>&1; then
    echo "The GitHub CLI ('gh') is required to verify release assets. Install it from https://cli.github.com/ or set SKIP_RELEASE_VERIFICATION=true to explicitly skip verification." >&2
    return 1
  fi

  command -v gh
}

assert_release_asset() {
  verify_github_cli_path="$1"
  verify_version="$2"
  verify_asset_path="$3"
  verify_asset_name="${verify_asset_path##*/}"

  if [ ! -f "$verify_asset_path" ]; then
    echo "Could not find release asset '$verify_asset_path'." >&2
    return 1
  fi

  # Bind the downloaded file to the exact immutable GitHub release.
  if ! "$verify_github_cli_path" release verify-asset "$verify_version" "$verify_asset_path" --repo "$RELEASE_REPOSITORY"; then
    echo "GitHub release verification failed for '$verify_asset_name'." >&2
    return 1
  fi

  # Verify that the expected workflow produced the file from the release tag.
  if ! "$verify_github_cli_path" attestation verify "$verify_asset_path" \
    --repo "$RELEASE_REPOSITORY" \
    --signer-workflow "$RELEASE_WORKFLOW" \
    --source-ref "refs/tags/$verify_version"; then
    echo "GitHub artifact attestation verification failed for '$verify_asset_name'." >&2
    return 1
  fi
}

# guess OS_TYPE if not provided
if [ -z "$OS_TYPE" ]; then
  case "$(uname -s | tr '[:upper:]' '[:lower:]')" in
    cygwin_nt*|mingw*|msys_nt*)
      OS_TYPE="windows"
      ;;
    linux*)
      if [ "$(ldd /bin/ls | grep -m1 'musl')" ]; then
        OS_TYPE="linux-musl"
      else
        OS_TYPE="linux-glibc"
      fi
      ;;
    darwin*)
      OS_TYPE="macos"
      ;;
  esac
fi

case "$OS_TYPE" in
  "linux-glibc"|"linux-musl"|"macos"|"windows")
    ;;
  *)
    echo "Set the operating system type using the OS_TYPE environment variable. Supported values: linux-glibc, linux-musl, macos, windows." >&2
    exit 1
    ;;
esac

# guess OS architecture if not provided
if [ -z "$ARCHITECTURE" ]; then
  case $(uname -m) in
    x86_64)  ARCHITECTURE="x64" ;;
    aarch64|arm64) ARCHITECTURE="arm64" ;;
  esac
fi

case "$ARCHITECTURE" in
  "x64"|"arm64")
    ;;
  *)
    echo "Set the architecture type using the ARCHITECTURE environment variable. Supported values: x64, arm64." >&2
    exit 1
    ;;
esac

if command -v curl > /dev/null 2>&1; then
  DOWNLOADER="curl -sSfLo"
elif command -v wget > /dev/null 2>&1; then
  DOWNLOADER="wget -qO"
else
  echo "Error: Neither curl nor wget is available." >&2
  exit 1
fi

test -z "$OTEL_DOTNET_AUTO_HOME" && OTEL_DOTNET_AUTO_HOME="$HOME/.otel-dotnet-auto"
test -z "$VERSION" && VERSION="v{{VERSION}}"

assert_release_version "$VERSION"

GITHUB_CLI_PATH=""
if [ "${SKIP_RELEASE_VERIFICATION:-false}" = "true" ]; then
  echo "Warning: GitHub release and artifact attestation verification is skipped. The ZIP archive will not be verified." >&2
else
  GITHUB_CLI_PATH="$(get_github_cli_path)"
fi

RELEASE_DOWNLOAD_DIR="$(mktemp -d "${TMPDIR:-/tmp}/otel-dotnet-auto.XXXXXX")"
cleanup_release_download_dir() {
  rm -rf "$RELEASE_DOWNLOAD_DIR"
}
trap cleanup_release_download_dir 0

if [ -z "${DOWNLOAD_DIR:-}" ]; then
  DOWNLOAD_DIR="$RELEASE_DOWNLOAD_DIR"
fi

RELEASES_URL="https://github.com/$RELEASE_REPOSITORY/releases"
ARCHIVE="opentelemetry-dotnet-instrumentation-$OS_TYPE.zip"

# In case of Linux, use architecture in the download path
if echo "$OS_TYPE" | grep -q "linux"; then
  ARCHIVE="opentelemetry-dotnet-instrumentation-$OS_TYPE-$ARCHITECTURE.zip"
fi

LOCAL_PATH="${LOCAL_PATH:=$DOWNLOAD_DIR/$ARCHIVE}"
if [ ! -f "${LOCAL_PATH}" ]; then
  (
    cd "$DOWNLOAD_DIR"
    echo "Downloading $VERSION for $OS_TYPE ($LOCAL_PATH)..."
    ${DOWNLOADER} "$LOCAL_PATH" "$RELEASES_URL/download/$VERSION/$ARCHIVE"
  )
else
  echo "Using local installation archive: $LOCAL_PATH"
fi

ARCHIVE_PATH="$RELEASE_DOWNLOAD_DIR/$ARCHIVE"
if [ "$LOCAL_PATH" != "$ARCHIVE_PATH" ]; then
  cp "$LOCAL_PATH" "$ARCHIVE_PATH"
fi

if [ "${SKIP_RELEASE_VERIFICATION:-false}" != "true" ]; then
  assert_release_asset "$GITHUB_CLI_PATH" "$VERSION" "$ARCHIVE_PATH"
fi

rm -rf "$OTEL_DOTNET_AUTO_HOME"
unzip -q "$ARCHIVE_PATH" -d "$OTEL_DOTNET_AUTO_HOME"
